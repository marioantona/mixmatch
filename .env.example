# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.
# Either the new publishable/secret keys or the legacy anon/service_role keys work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Only used by `npm run seed`. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Demo origin (Piccadilly Gardens, Manchester). Change to seed a different city.
NEXT_PUBLIC_DEMO_LAT=53.4808
NEXT_PUBLIC_DEMO_LNG=-2.2374
SEED_RADIUS_KM=1.6
